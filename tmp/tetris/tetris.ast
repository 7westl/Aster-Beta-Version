
extern fn _kbhit() -> int;
extern fn _getch() -> int;
extern fn Sleep(int milliseconds) -> void;

int WIDTH = 10;
int HEIGHT = 20;

struct Piece {
    list<list<int>> shape;
    int x;
    int y;
};

struct Tetris {
    list<list<int>*> board;
    int score;
    int lines;
    int turn;
    bool game_over;
    Piece current;
    list<list<int>> next_shape;
};

fn create_shape(int type) -> list<list<int>> {
    if (type == 0) {
        return [[1, 1, 1, 1]];
    } else if (type == 1) {
        return [[1, 1], [1, 1]];
    } else if (type == 2) {
        return [[0, 1, 0], [1, 1, 1]];
    } else if (type == 3) {
        return [[1, 0, 0], [1, 1, 1]];
    } else if (type == 4) {
        return [[0, 0, 1], [1, 1, 1]];
    } else if (type == 5) {
        return [[0, 1, 1], [1, 1, 0]];
    }

    return [[1, 1, 0], [0, 1, 1]];
}

fn random_shape(int seed) -> list<list<int>> {
    int type = seed % 7;
    return create_shape(type);
}

fn init_board(Tetris* game) -> void {
    game->board = [];

    for (int y = 0; y < HEIGHT; y++) {
        list<int> row = [];

        for (int x = 0; x < WIDTH; x++) {
            row.append(0);
        }

        game->board.append(&row);
    }
}

fn get_cell(Tetris* game, int x, int y) -> int {
    list<int>* row = game->board[y];
    return (*row)[x];
}

fn set_cell(Tetris* game, int x, int y, int value) -> void {
    list<int>* row = game->board[y];
    (*row)[x] = value;
}

fn valid_position(Tetris* game, list<list<int>> shape, int px, int py) -> bool {
    for (int r = 0; r < len(shape); r++) {
        for (int c = 0; c < len(shape[r]); c++) {
            if (shape[r][c] != 0) {
                int nx = px + c;
                int ny = py + r;

                if (nx < 0 or nx >= WIDTH or ny >= HEIGHT) {
                    return false;
                }

                if (ny >= 0 and get_cell(game, nx, ny) != 0) {
                    return false;
                }
            }
        }
    }

    return true;
}

fn spawn_piece(Tetris* game) -> void {
    game->turn += 1;

    game->current.shape = game->next_shape;
    game->current.x = WIDTH / 2 - len(game->current.shape[0]) / 2;
    game->current.y = 0;

    game->next_shape = random_shape(game->turn * 17 + 31);

    if (not valid_position(
        game,
        game->current.shape,
        game->current.x,
        game->current.y
    )) {
        game->game_over = true;
    }
}

fn move_piece(Tetris* game, int dx, int dy) -> bool {
    int nx = game->current.x + dx;
    int ny = game->current.y + dy;

    if (valid_position(game, game->current.shape, nx, ny)) {
        game->current.x = nx;
        game->current.y = ny;
        return true;
    }

    return false;
}

fn rotate_piece(Tetris* game) -> void {
    list<list<int>> rotated = [];

    int rows = len(game->current.shape);
    int cols = len(game->current.shape[0]);

    for (int x = 0; x < cols; x++) {
        list<int> row = [];

        for (int y = rows - 1; y >= 0; y--) {
            row.append(game->current.shape[y][x]);
        }

        rotated.append(row);
    }

    list<int> offsets = [0, -1, 1, -2, 2];

    for (int i = 0; i < len(offsets); i++) {
        int nx = game->current.x + offsets[i];

        if (valid_position(game, rotated, nx, game->current.y)) {
            game->current.shape = rotated;
            game->current.x = nx;
            return;
        }
    }
}

fn clear_lines(Tetris* game) -> void {
    int cleared = 0;

    for (int y = HEIGHT - 1; y >= 0; y--) {
        bool full = true;

        for (int x = 0; x < WIDTH; x++) {
            if (get_cell(game, x, y) == 0) {
                full = false;
                break;
            }
        }

        if (full) {
            cleared += 1;

            for (int row = y; row > 0; row--) {
                for (int x = 0; x < WIDTH; x++) {
                    set_cell(game, x, row, get_cell(game, x, row - 1));
                }
            }

            for (int x = 0; x < WIDTH; x++) {
                set_cell(game, x, 0, 0);
            }

            y += 1;
        }
    }

    game->lines += cleared;

    if (cleared == 1) {
        game->score += 100;
    } else if (cleared == 2) {
        game->score += 300;
    } else if (cleared == 3) {
        game->score += 500;
    } else if (cleared == 4) {
        game->score += 800;
    }
}

fn lock_piece(Tetris* game) -> void {
    for (int r = 0; r < len(game->current.shape); r++) {
        for (int c = 0; c < len(game->current.shape[r]); c++) {
            if (game->current.shape[r][c] != 0) {
                int x = game->current.x + c;
                int y = game->current.y + r;

                if (y >= 0 and y < HEIGHT and x >= 0 and x < WIDTH) {
                    set_cell(game, x, y, 1);
                }
            }
        }
    }

    clear_lines(game);
    spawn_piece(game);
}

fn hard_drop(Tetris* game) -> void {
    while (move_piece(game, 0, 1)) {
        game->score += 2;
    }

    lock_piece(game);
}

fn draw_board(Tetris* game) -> void {
    print("\x1b[H");
    println("+--------------------+");

    for (int y = 0; y < HEIGHT; y++) {
        str line = "|";

        for (int x = 0; x < WIDTH; x++) {
            int cell = get_cell(game, x, y);

            for (int r = 0; r < len(game->current.shape); r++) {
                for (int c = 0; c < len(game->current.shape[r]); c++) {
                    if (
                        game->current.shape[r][c] != 0
                        and game->current.x + c == x
                        and game->current.y + r == y
                    ) {
                        cell = 2;
                    }
                }
            }

            if (cell == 2) {
                line += "[]";
            } else if (cell == 1) {
                line += "##";
            } else {
                line += "  ";
            }
        }

        println(line + "|");
    }

    println("+--------------------+");
    println("SCORE: " + str(game->score));
    println("LINES: " + str(game->lines));
    println("A/D: MOVE | W: ROTATE | S: DOWN");
    println("SPACE: DROP | Q: QUIT");
}

fn main() -> void {
    Tetris game;

    game.score = 0;
    game.lines = 0;
    game.turn = 0;
    game.game_over = false;

    init_board(&game);

    game.next_shape = random_shape(1);
    spawn_piece(&game);

    print("\x1b[2J");
    print("\x1b[?25l");

    int fall_timer = 0;
    bool running = true;

    while (running and not game.game_over) {
        if (_kbhit() != 0) {
            int key = _getch();

            if (key == 0 or key == 224) {
                int extended = _getch();
            } else if (key == 97 or key == 65) {
                move_piece(&game, -1, 0);
            } else if (key == 100 or key == 68) {
                move_piece(&game, 1, 0);
            } else if (key == 119 or key == 87) {
                rotate_piece(&game);
            } else if (key == 115 or key == 83) {
                if (move_piece(&game, 0, 1)) {
                    game.score += 1;
                }
            } else if (key == 32) {
                hard_drop(&game);
            } else if (key == 113 or key == 81 or key == 27) {
                running = false;
            }
        }

        fall_timer += 16;

        if (fall_timer >= 500) {
            fall_timer = 0;

            if (not move_piece(&game, 0, 1)) {
                lock_piece(&game);
            }
        }

        draw_board(&game);
        Sleep(50);
    }

    print("\x1b[?25h");
    println("GAME OVER");
    println("SCORE: " + str(game.score));
    println("LINES: " + str(game.lines));
}

main();