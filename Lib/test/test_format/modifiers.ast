public class Widget {
    public static const int LIMIT = 10;
    private readonly int id;
    internal int state;
    constructor(int v) {
        self->id = v;
        self->state = 0;
    }
    public fn get() -> int { return self->id; }
    static fn make() -> int { return Widget.LIMIT; }
}

