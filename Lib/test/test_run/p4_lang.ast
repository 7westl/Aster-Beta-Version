/* ---------- validation errors ---------- */
println("== errors ==");
try {
    Integer.parseInt("42x");
} catch (ValueError e) {
    print("parse: " + e.name);println(" \"parse: \" + e.name");
}
try {
    Integer.parseInt("7", 99);
} catch (ValueError e) {
    print("radix: " + e.name);println(" \"radix: \" + e.name");
}
try {
    Character bad = new Character("");
} catch (ValueError e) {
    print("char: " + e.name);println(" \"char: \" + e.name");
}
try {
    Math.addExact(9223372036854775807, 1);
} catch (OverflowError e) {
    print("overflow: " + e.name);println(" \"overflow: \" + e.name");
}
print(Double.isNaN(Double.parseDouble("NaN")));println(" Double.isNaN(Double.parseDouble(\"NaN\"))");
print(Float.isInfinite(Float.parseFloat("-Infinity")));println(" Float.isInfinite(Float.parseFloat(\"-Infinity\"))");
print(Integer.parseInt("2147483647"));println(" Integer.parseInt(\"2147483647\")");
print(Integer.parseInt("-2147483648"));println(" Integer.parseInt(\"-2147483648\")");
print(Long.parseLong("-9223372036854775808"));println(" Long.parseLong(\"-9223372036854775808\")");
try { Integer.parseInt("2147483648"); } catch (ValueError e) { print("int-range: " + e.name);println(" \"int-range: \" + e.name"); }
try { Long.parseLong("9223372036854775808"); } catch (ValueError e) { print("long-range: " + e.name);println(" \"long-range: \" + e.name"); }
try { Long.parseLong("ffffffffffffffff", 16); } catch (ValueError e) { print("long-hex-range: " + e.name);println(" \"long-hex-range: \" + e.name"); }
