/* ---------- custom interfaces ---------- */
class Version implements Comparable, Cloneable {
    private int major;
    private int minor;

    constructor(int a, int b) {
        self->major = a;
        self->minor = b;
    }

    public fn compareTo(any other) -> int {
        Version o = (Version) other;
        if (self->major < o->major) { return -1; }
        if (self->major > o->major) { return 1; }
        if (self->minor < o->minor) { return -1; }
        if (self->minor > o->minor) { return 1; }
        return 0;
    }

    public fn cloneValue() -> Version {
        return new Version(self->major, self->minor);
    }

    public fn __str__() -> str {
        return str(self->major) + "." + str(self->minor);
    }
}

class Text implements CharSequence {
    private str data;

    constructor(str d) {
        self->data = d;
    }

    public fn length() -> int {
        return self->data.length();
    }

    public fn charAt(int index) -> str {
        return self->data.charAt(index);
    }

    public fn substring(int start) -> str {
        return self->data.substring(start);
    }

    public fn substring(int start, int end) -> str {
        return self->data.substring(start, end);
    }

    public fn toString() -> str {
        return self->data;
    }

    public fn __str__() -> str {
        return self->data;
    }
}

class Task implements Runnable, AutoCloseable {
    public int runs;
    public bool closed;

    constructor() {
        self->runs = 0;
        self->closed = false;
    }

    public fn run() -> void {
        self->runs = self->runs + 1;
    }

    public fn close() -> void {
        self->closed = true;
    }
}

println("== interfaces ==");
Version v1 = new Version(1, 2);
Version v2 = new Version(2, 0);
print(v1->compareTo(v2));println(" v1->compareTo(v2)");
print(v2->compareTo(v1));println(" v2->compareTo(v1)");
print(v1->compareTo(v1->cloneValue()));println(" v1->compareTo(v1->cloneValue())");
any cmp = v2;
print(cmp->compareTo(v1));println(" cmp->compareTo(v1)");
any cl = v1;
print(cl != null);println(" cl != null");
print(v1);println(" v1");

Text text = new Text("Aster");
print(text->length());println(" text->length()");
print(text->charAt(1));println(" text->charAt(1)");
print(text->substring(1, 3));println(" text->substring(1, 3)");
print(text->toString());println(" text->toString()");
any seq = text;
print(seq->length());println(" seq->length()");
print(seq->charAt(0));println(" seq->charAt(0)");
print(seq->substring(1));println(" seq->substring(1)");
print(seq->toString());println(" seq->toString()");

Task task = new Task();
print(task->runs);println(" task->runs");
any runner = task;
runner->run();
runner->run();
print(task->runs);println(" task->runs");
any resource = task;
print(task->closed);println(" task->closed");
resource->close();
print(task->closed);println(" task->closed");

