export extern fn cbrt(float x) -> float;

fn add(int a, int b) -> int {
    return a + b;
}

fn gcd(int a, int b) -> int {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

fn sumTo(int n) -> int {
    int total = 0;
    for (int i = 0; i < n; i += 1) {
        total += i;
    }
    return total;
}

fn rangeSum(int n) -> int {
    int total = 0;
    for (int i; i = 1..n..1) {
        total += i;
    }
    return total;
}

fn classify(int n) -> str {
    if (n < 0) {
        return "neg";
    }
    else if (n == 0) {
        return "zero";
    }
    return n > 100 ? "big" : "small";
}

fn fact(int n) -> int {
    return n <= 1 ? 1 : n * fact(n - 1);
}

fn cbrtTwice(float x) -> float {
    return cbrt(x) * 2.0;
}

fn report(int n) -> void {
    println(n);
}

fn shifted(int n) -> int {
    int a = n << 2;
    a >>= 1;
    return a;
}

fn casting(float x) -> int {
    return (int)x;
}

class Counter {
    static fn twice(int n) -> int {
        return add(n, n);
    }
}

fn useStatic(int n) -> int {
    return Counter.twice(n);
}

fn badInferred(int n) -> int {
    var v = n;
    return v;
}

fn callBad(int n) -> int {
    return badInferred(n);
}
